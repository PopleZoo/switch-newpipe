<brls:AppletFrame
        iconInterpolation="linear"
        headerHidden="true"
        footerHidden="true">
    <brls:Box
            axis="column"
            width="100%"
            height="100%">
        <AutoTabFrame
                id="main/tabs"
                grow="1"
                tabBackgroundColor="@theme/color/newpipe_bg"
                tabItemActiveTextColor="@theme/color/newpipe"
                defaultTab="0"
                demandMode="true">

            <Tab
                    label=""
                    fontSize="18"
                    icon="@res/svg/home.svg"
                    iconActivate="@res/svg/home_active.svg">
                <HomeTab/>
            </Tab>

            <Tab
                    label=""
                    fontSize="18"
                    icon="@res/svg/search.svg"
                    iconActivate="@res/svg/search_active.svg">
                <SearchTab/>
            </Tab>

            <Tab
                    label=""
                    fontSize="18"
                    icon="@res/svg/subscriptions.svg"
                    iconActivate="@res/svg/subscriptions_active.svg">
                <SubscriptionsTab/>
            </Tab>

            <Tab
                    label=""
                    fontSize="18"
                    icon="@res/svg/library.svg"
                    iconActivate="@res/svg/library_active.svg">
                <LibraryTab/>
            </Tab>

            <Tab
                    label=""
                    fontSize="18"
                    icon="@res/svg/settings.svg"
                    iconActivate="@res/svg/settings_active.svg">
                <SettingsTab/>
            </Tab>
        </AutoTabFrame>

        <!-- Bottom overlay hint for ZR menu -->
        <brls:Label
            id="main/zr_hint"
            width="100%"
            height="40"
            text="@i18n/main/zr_hint"
            fontSize="16"
            textColor="#808080"
            horizontalAlign="center"
            verticalAlign="center"
            marginBottom="8"
            visibility="visible" />
    </brls:Box>
</brls:AppletFrame>
