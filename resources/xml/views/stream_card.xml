<brls:Box
    width="33.33%"
    height="auto"
    axis="column"
    paddingLeft="8"
    paddingRight="8"
    paddingTop="8"
    paddingBottom="10"
    marginBottom="8"
    focusable="true"
    cornerRadius="10"
    backgroundColor="#1E2023">

    <brls:Image
        id="stream/thumbnail"
        width="100%"
        height="auto"
        aspectRatio="1.7778"
        scalingType="fill"
        cornerRadius="8"
        backgroundColor="#141517" />

    <brls:Label
        id="stream/title"
        width="100%"
        height="auto"
        fontSize="17"
        marginTop="8"
        textColor="#FFFFFF" />

    <brls:Label
        id="stream/channel"
        width="100%"
        height="auto"
        fontSize="13"
        textColor="#F44336"
        marginTop="4" />

    <brls:Label
        id="stream/meta"
        width="100%"
        height="auto"
        fontSize="12"
        textColor="#909090"
        marginTop="4" />
</brls:Box>
